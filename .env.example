DEBUG=False
SECRET_KEY=change-me
# Hosts that may serve this app. Use your container host's IP or hostname.
ALLOWED_HOSTS=localhost,127.0.0.1
# Only needed behind an https reverse proxy, e.g. https://youtubarr.example.com
CSRF_TRUSTED_ORIGINS=
LIDARR_TOKEN=choose-a-long-random-token

# YouTube Data API key (public + unlisted playlists).
# Leave blank to set it from the Settings page instead.
# NOTE: do not put comments on the same line as a value - the whole line becomes the value.
YOUTUBE_API_KEY=
YOUTUBE_QUOTA_SAFE_PAGE_SIZE=50

# YouTube OAuth - required for PRIVATE playlists and Liked Music.
# These must be the same client you used to run `ytmusicapi oauth`.
YOUTUBE_OAUTH_CLIENT_ID=your-client-id
YOUTUBE_OAUTH_CLIENT_SECRET=your-client-secret

# Where the sqlite db and oauth.json live inside the container.
DATA_DIR=/data

# MusicBrainz - set a real contact email
MB_USER_AGENT=YTM-Lidarr-List/1.0 (contact@example.com)

# Celery / Redis
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# Periodic refresh (in minutes)
REFRESH_MINUTES=60

# Optional forward proxy for outbound requests (YouTube Data API, MusicBrainz).
# Only needed when this container shares a VPN container's network namespace
# (see docker-compose.yml's netproxy service) and you want that traffic to
# leave via the LAN instead of the tunnel. `requests` (and the Google auth
# libraries used for OAuth) pick these up automatically. Leave blank otherwise.
HTTP_PROXY=
HTTPS_PROXY=
